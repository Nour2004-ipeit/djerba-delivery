# ========================================================
# Git Ignore Configuration - Djerba Delivery Fullstack Project
# ========================================================

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Environment variables & secrets (CRITICAL)
.env
.env*.local
.env.development
.env.production
*.pem
*.key

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
auth-debug.log*

# Node.js & Next.js Artifacts
node_modules/
.next/
out/
.vercel
*.tsbuildinfo
next-env.d.ts

# Local Databases (Keep schemas, ignore local data files)
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-shm
*.db-wal

# Flutter & Dart Build Artifacts
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
*.mode1v3
*.mode2v3
*.moved-aside
*.pbxuser
*.perspectivev3

# IDE & Editor Files
.idea/
.vscode/
*.iml
*.iws
*.ipr
.fleet/

# Demonstration Video (124MB exceeds GitHub's 100MB limit - host via GitHub Releases or LFS)
*.mp4
*.mov
*.avi
demo.mp4

# Temporary & Scratch Files
tmp/
temp/
*step_*.txt
build_log.txt
