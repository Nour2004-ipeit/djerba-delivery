# ========================================================
# Djerba Delivery Backend - Environment Configuration Template
# ========================================================

# Base application URL
BETTER_AUTH_URL=http://localhost:3000

# Better Auth Secret Key (Generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=your_super_secret_djerba_delivery_auth_key_here

# --- DATABASE CONFIGURATION (Turso / LibSQL) ---
# For local SQLite development (file:sqlite.db), or remote Turso database:
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# --- REDIS CONFIGURATION (Upstash Redis) ---
# Used for real-time spatial geosearch (5km courier radar) and atomic order locking (SET NX EX 10)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# --- EMAIL NOTIFICATIONS (Nodemailer / SMTP) ---
# Configured for transactional alerts and OTPs
SMTP_USER=your_email@domain.com
SMTP_PASS=your_smtp_app_password

# --- SMS NOTIFICATIONS (Twilio) ---
# Optional: Twilio credentials for SMS order updates
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# --- PUSH NOTIFICATIONS (Firebase Cloud Messaging) ---
# Optional: FCM service account credentials for cross-platform push alerts
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_service_account_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
